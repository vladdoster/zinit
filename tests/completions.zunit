#!/usr/bin/env zunit

#
# zdharma-continuum/zinit/tests/completions.zunit
# Copyright (c) 2016-2021 Sebastian Gniazdowski
# Copyright (c) 2021-2026 zdharma-continuum
# Homepage: https://github.com/zdharma-continuum/zinit
# License: MIT License
#
# Detection rules for `_*' completion files. Every one of these must hold
# identically for creinstall, cuninstall, report, csearch and zstatus - they
# all go through .zinit-find-completion-candidates().
#

@setup {
  ZPLUGINS=$ZINIT[PLUGINS_DIR]
  ZCOMPS=$ZINIT[COMPLETIONS_DIR]
  # zunit has no `not_exists' assertion; ices.zunit defines the same helper.
  function _zunit_assert_not_exists(){
    local file_path=$1
    [[ ! -e "$file_path" ]] && return 0
    echo "found '${file_path}'"
    exit 1
  }
}

@test 'underscore-directories are not completions' {
  # Regression: zdharma-continuum/zunit ships tests/_support and tests/_output,
  # which were matched by the globs behind `report', `cuninstall' and `zstatus'.
  run zinit as"null" id-as"test/dircomp" \
    atclone"mkdir -p tests/_support tests/_output; print '#compdef v' > _valid" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZPLUGINS/test---dircomp/tests/_support" is_dir
  assert "$ZPLUGINS/test---dircomp/tests/_output" is_dir
  assert "$ZCOMPS/_valid" is_file
  assert "$ZCOMPS/_support" not_exists
  assert "$ZCOMPS/_output" not_exists
}

@test 'underscore-directories are hidden from csearch and cuninstall' {
  # `zinit report' is not usable here - it needs a plugin loaded WITH reporting,
  # and as'null' yields "No such plugin". csearch and cuninstall both walk the
  # plugin directory directly, which is what this is really about.
  run zinit as"null" id-as"test/dircomp2" \
    atclone"mkdir -p tests/_support tests/_output; print '#compdef v' > _valid2" \
    completions for zdharma-continuum/null
  assert $state equals 0

  run zinit csearch
  assert $state equals 0
  assert $output contains '_valid2'
  assert $output does_not_contain '_support'
  assert $output does_not_contain '_output'

  # Before the fix this printed "Completion `_output' not installed." twice.
  run zinit cuninstall test/dircomp2
  assert $state equals 0
  assert $output contains '_valid2'
  assert $output does_not_contain '_support'
  assert $output does_not_contain '_output'
}

@test 'a completion shipped as a symlink is still detected' {
  # (.) would drop this and (^/) would keep symlinked directories - (-.) is
  # the only qualifier that gets both cases right.
  run zinit as"null" id-as"test/symcomp" \
    atclone"print '#compdef real' > real; ln -s real _real" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_real" is_file
}

@test 'a dangling symlink is not installed as a completion' {
  run zinit as"null" id-as"test/dangling" \
    atclone"ln -s nowhere-at-all _dangling; print '#compdef o' > _ok" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_ok" is_file
  assert "$ZCOMPS/_dangling" not_exists
}

@test 'the ignore list applies uniformly to install and to the listings' {
  # The exclusion lists had drifted: *.yaml and *.py were filtered at install
  # time only, so csearch/report/zstatus still listed them and `cuninstall'
  # iterated them; *.lua was the mirror image - installed, but invisible to
  # csearch. One shared list means every command now agrees.
  run zinit as"null" id-as"test/uniform" \
    atclone"print '#compdef t' | tee _thing _thing.py _thing.yaml _thing.lua > /dev/null" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_thing" is_file
  assert "$ZCOMPS/_thing.py" not_exists
  assert "$ZCOMPS/_thing.yaml" not_exists
  assert "$ZCOMPS/_thing.lua" not_exists

  run zinit csearch
  assert $state equals 0
  assert $output does_not_contain '_thing.py'
  assert $output does_not_contain '_thing.yaml'
  assert $output does_not_contain '_thing.lua'
}

@test 'files without a #compdef line are skipped, with a warning' {
  # Installed via `creinstall', which carries no ice, so the content check
  # applies (an explicit as'completion'/completions ice would bypass it).
  run zinit as"null" id-as"test/untagged" \
    atclone"touch _untagged; print '#compdef t' > _tagged" \
    for zdharma-continuum/null
  assert $state equals 0

  run zinit creinstall test/untagged
  assert $state equals 0
  assert "$ZCOMPS/_tagged" is_file
  assert "$ZCOMPS/_untagged" not_exists
  assert $output contains '_untagged'
}

@test '#autoload helper functions count as completions' {
  run zinit as"null" id-as"test/autoload" \
    atclone"print '#autoload +X' > _helper" for zdharma-continuum/null
  assert $state equals 0

  run zinit creinstall test/autoload
  assert $state equals 0
  assert "$ZCOMPS/_helper" is_file
}

@test 'the completions ice forces an untagged file' {
  # This is the contract that keeps tests/ices.zunit green.
  run zinit as"null" id-as"test/forced" atclone"touch _forced" completions \
    for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_forced" is_file
}

@test 'completions-strict no restores lax detection' {
  # The bootstrap pre-sets every ZINIT[KEY], which would mask the zstyle path,
  # so exercise this in a clean `zsh -fc' subshell as config-zstyle.zunit does.
  output=$(zsh -fc 'zmodload zsh/zutil; typeset -gAH ZINIT
    ZINIT[BIN_DIR]='"${ZINIT[BIN_DIR]}"'
    zstyle ":zinit:config" completions-strict no
    source '"${ZINIT[BIN_DIR]}"'/zinit.zsh >/dev/null 2>&1
    print -r -- ${ZINIT[COMPLETIONS_STRICT]}')
  state=$?
  assert $state equals 0
  assert $output same_as 'no'
}

@test 'a completion named by its #compdef line installs under that name' {
  # g-plane/pnpm-shell-completion ships `pnpm-shell-completion.plugin.zsh',
  # mislav/hub ships `hub.zsh_completion' - names compinit would never look at.
  run zinit as"null" id-as"test/derived" \
    atclone"print '#compdef drv' > drv.plugin.zsh" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_drv" is_file
  assert "$ZCOMPS/drv.plugin.zsh" not_exists
}

@test 'a derived-name completion is visible to csearch and cuninstall' {
  # The regression this whole file exists to prevent: install used to know about
  # these files and every listing command did not, so the symlink was invisible
  # to `csearch'/`report' and `cuninstall' orphaned it.
  run zinit as"null" id-as"test/derived2" \
    atclone"print '#compdef drv2' > drv2.plugin.zsh" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_drv2" is_file

  run zinit csearch
  assert $state equals 0
  assert $output contains '_drv2'

  run zinit cuninstall test/derived2
  assert $state equals 0
  assert $output contains '_drv2'
  assert "$ZCOMPS/_drv2" not_exists
}

@test 'only the first command of a #compdef line names the file' {
  run zinit as"null" id-as"test/multi" \
    atclone"print '#compdef mcc m++ mc' > multi.zsh" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_mcc" is_file
  assert "$ZCOMPS/_mccm++mc" not_exists
}

@test 'the #compdef -p pattern form names no file and is skipped' {
  run zinit as"null" id-as"test/patform" \
    atclone"print '#compdef -p gitp-*' > patform.zsh; print '#compdef okp' > okp.zsh" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_okp" is_file
  assert "$ZCOMPS/_-p" not_exists
}

@test 'a real _name file wins a collision with a derived name' {
  run zinit as"null" id-as"test/collide" \
    atclone"print '#compdef cld real' > _cld; print '#compdef cld' > cld.zsh" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_cld" is_file

  output="$(readlink $ZCOMPS/_cld)"
  state=$?
  assert $state equals 0
  assert "${output:t}" same_as '_cld'
}

@test 'a compiled .zwc is never installed as a completion' {
  run zinit as"null" id-as"test/zwc" \
    atclone"print '#compdef zwcok' > zwcok.zsh; print '#compdef zwcbad' > zwcbad.zsh.zwc" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_zwcok" is_file
  assert "$ZCOMPS/_zwcbad" not_exists
}

@test 'the derivation rules hold uniformly' {
  # One pass over every rule at once, without the network round-trip: the
  # install name of each candidate, in scan order.
  output=$(zsh -fc 'typeset -gA ZINIT
    ZINIT[COMPLETION_IGNORE]="*.zwc|*.py"
    ZINIT[COMPLETIONS_STRICT]=yes
    ZINIT[COMPLETION_DERIVE_NAMES]=yes
    source '"${ZINIT[BIN_DIR]}"'/zinit-side.zsh
    d=$(mktemp -d)/u---p
    mkdir -p $d
    print "#autoload +X"      > $d/_helper
    print "#compdef foo"      > $d/_foo
    print "#compdef bar"      > $d/bar.plugin.zsh
    print "#compdef gcc g++"  > $d/multi.zsh
    print "#compdef -p pat-*" > $d/patform.zsh
    print "#compdef hub"      > $d/hub.zsh_completion
    print "#compdef zwc"      > $d/cached.zsh.zwc
    print "#compdef foo"      > $d/foo.zsh
    print "just a script"     > $d/other.zsh
    .zinit-find-completion-candidates $d validate
    print -r -- ${(j:,:)reply3}')
  state=$?
  assert $state equals 0
  assert $output same_as '_foo,_helper,_bar,_hub,_gcc'
}

@test 'completion-derive-names no requires the _name convention' {
  output=$(zsh -fc 'typeset -gA ZINIT
    ZINIT[COMPLETION_IGNORE]="*.zwc"
    ZINIT[COMPLETION_DERIVE_NAMES]=no
    source '"${ZINIT[BIN_DIR]}"'/zinit-side.zsh
    d=$(mktemp -d)/u---p
    mkdir -p $d
    print "#compdef dn" > $d/dn.zsh
    print "#compdef ok" > $d/_ok
    .zinit-find-completion-candidates $d
    print -r -- ${(j:,:)reply3}')
  state=$?
  assert $state equals 0
  assert $output same_as '_ok'
}

@test 'a local-directory plugin reports its completions' {
  # zinit-autoload.zsh used to hand-build ${PLUGINS_DIR}/%$plugin here, a path
  # that can never exist, so `zinit report' on a local directory or a snippet
  # always claimed zero completions - independently of the naming question.
  output=$(zsh -fc 'typeset -gA ZINIT
    ZINIT[BIN_DIR]='"${ZINIT[BIN_DIR]}"'
    source '"${ZINIT[BIN_DIR]}"'/zinit.zsh >/dev/null 2>&1
    source '"${ZINIT[BIN_DIR]}"'/zinit-autoload.zsh >/dev/null 2>&1
    d=$(mktemp -d)/localplug
    mkdir -p $d/._zinit
    print "#compdef lcl" > $d/_lcl
    print "#compdef drv" > $d/drv.plugin.zsh
    .zinit-find-completions-of-plugin "%" "$d"
    print -r -- ${(j:,:)reply3}' 2>/dev/null)
  state=$?
  assert $state equals 0
  assert $output same_as '_lcl,_drv'
}

@test 'a .zsh-completion file is named by its #compdef line' {
  # molovo/revolver's shape, hermetically: the `*.zsh-completion' glob arm is
  # not reached by any of the tests above, which all use `.plugin.zsh'/`.zsh'.
  run zinit as"null" id-as"test/revcomp" \
    atclone"print '#compdef revc' > revc.zsh-completion" \
    completions for zdharma-continuum/null
  assert $state equals 0
  assert "$ZCOMPS/_revc" is_file
  assert "$ZCOMPS/revc.zsh-completion" not_exists
}

@test 'molovo/revolver: install, report, cdisable, cenable' {
  # The real recipe, verbatim:
  #   zinit ice wait"2" lucid as"program" pick"revolver"
  #   zinit light molovo/revolver
  # revolver ships `revolver.zsh-completion' whose first line is `#compdef
  # revolver' - no `_revolver' anywhere in the repository.
  #
  # `wait'' is driven by `zle -F'/precmd, and a zunit test shell has neither;
  # the fresh-clone shortcut (zinit.zsh:2887) needs ${zsh_eval_context[1]} =
  # file, which only holds for a sourced .zshrc - inside zunit it is `toplevel'.
  # Left alone the recipe just queues a ZINIT_TASKS entry and returns.
  # `@zinit-scheduler burst' is the documented scripted equivalent: it marks
  # every task timed out and skips the `zle -F' re-arm (zinit.zsh:2542-2552).
  #
  # zunit only unsets ERR_EXIT inside `run', and a bare `zinit light' trips it.
  unsetopt ERR_EXIT

  zinit ice wait"2" lucid as"program" pick"revolver"
  zinit light molovo/revolver
  assert "${#ZINIT_TASKS}" is_greater_than 0
  @zinit-scheduler burst

  assert "$ZPLUGINS/molovo---revolver/revolver.zsh-completion" is_file
  assert "$ZCOMPS/_revolver" is_link

  # `light' registers the plugin just as `load' does (zinit.zsh:1749); only the
  # diff sections come back empty. The Completions block is filesystem-derived.
  # The name is printed uncoloured and the state wrapped in SGR escapes, so
  # these have to be two separate assertions.
  run zinit report molovo/revolver
  assert $state equals 0
  assert $output contains '_revolver'
  assert $output contains '[enabled]'

  run zinit cdisable revolver
  assert $state equals 0
  assert $output contains 'Disabled'
  assert "$ZCOMPS/_revolver" not_exists
  assert "$ZCOMPS/revolver" is_link

  run zinit report molovo/revolver
  assert $state equals 0
  assert $output contains '_revolver'
  assert $output contains '[disabled]'

  run zinit cenable revolver
  assert $state equals 0
  assert $output contains 'Enabled'
  assert "$ZCOMPS/_revolver" is_link

  run zinit report molovo/revolver
  assert $state equals 0
  assert $output contains '[enabled]'
}

@test 'completion-ignore-dirs is anchored at the plugin directory' {
  # A plugin whose install path contains a `test' component must not lose all
  # of its completions: the filter runs on the path relative to the plugin.
  output=$(zsh -fc 'typeset -gA ZINIT
    ZINIT[COMPLETION_IGNORE]="*.zwc"
    ZINIT[COMPLETION_IGNORE_DIRS]="tests|spec"
    source '"${ZINIT[BIN_DIR]}"'/zinit-side.zsh
    d=$(mktemp -d)/test/plugins/u---p
    mkdir -p $d/tests
    print "#compdef r" > $d/_root
    print "#compdef n" > $d/tests/_nested
    .zinit-find-completion-candidates $d
    print -r -- ${(j:,:)${(@)reply:t}}')
  state=$?
  assert $state equals 0
  assert $output same_as '_root'
}

