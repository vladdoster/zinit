{
  "rules": {
    "header-max-length": [2, "always", 80],
    "subject-case": [2, "always", ["lower-case", "sentence-case", "start-case"]],
    "type-case": [2, "always", ["lower-case"]],
    "type-empty": [2, "never"],
    "type-enum": [2, "always", ["build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "style", "test"]]
  }
}
